#!/bin/sh
#
# pre-commit hook: checks the language of staged text.
#
# English and Ukrainian are allowed. Other Cyrillic-script text is rejected,
# but since it shares most of the Cyrillic block with Ukrainian, we cannot ban
# all Cyrillic. Instead we look for signals that are absent from the
# Ukrainian alphabet and vocabulary:
#   1. the letters ъ ы э ё (Ukrainian uses ' / і / е / є instead), and
#   2. a curated list of common words that are not valid Ukrainian.
# Ukrainian-only letters (і ї є ґ) and Ukrainian words never trigger the hook.
#
# Only staged content is scanned (never the working tree or dependencies),
# and binary files plus common vendored/lock paths are skipped.

# Language detector, applied to a stream on stdin. Prints matching lines as
# "<line-number>: <line-content>". `-CSD` decodes stdin as UTF-8 and `-Mutf8`
# decodes this script's own Cyrillic literals, so both sides are compared as
# Unicode code points rather than raw bytes.
scan() {
	perl -CSD -Mutf8 -ne '
		# 1. Cyrillic letters that are not in the Ukrainian alphabet.
		if (/[ъыэёЪЫЭЁ]/) { print "    line $.: $_"; next }
		# 2. Characteristic non-Ukrainian words, matched as whole Cyrillic tokens
		#    (case-insensitive). Each is chosen so it is NOT a valid Ukrainian
		#    word, and the lookarounds keep Ukrainian words that merely contain
		#    these letters from matching.
		if (/(?<!\p{Cyrillic})(?:это|этот|эта|эти|что|чтобы|потому|почему|если|или|нет|как|какой|когда|сейчас|очень|спасибо|пожалуйста|привет|здравствуйте|хорошо|плохо|который|которые|которых|время|пользователь|настройки|удалить|сохранить|добавить|изменить|ошибка|только|ещё|еще|всегда|нужно|здесь|сегодня|русский|русском|русского)(?!\p{Cyrillic})/i) {
			print "    line $.: $_";
		}
	'
}

found=0

# Read staged file paths one per line. `IFS=` and `read -r` keep spaces in
# paths intact. --diff-filter=ACM: only Added, Copied, Modified (skip
# deletions). Newlines inside file names are not supported (extremely rare).
while IFS= read -r file; do
	[ -n "$file" ] || continue
	# Skip dependency, virtualenv and lock files; the Ukrainian localisation
	# files (legitimately full of Cyrillic); and this hook itself (it must
	# contain the sample words/letters in order to detect them).
	case "$file" in
	node_modules/* | */node_modules/*) continue ;;
	.venv/* | */.venv/*) continue ;;
	*.lock | *-lock.json | *-lock.yaml | *-lock.yml) continue ;;
	package-lock.json | */package-lock.json) continue ;;
	src/i18n/uk.ts | */i18n/uk.ts | i18n/uk.ts) continue ;;
	.githooks/pre-commit | */.githooks/pre-commit) continue ;;
	esac

	# Skip binary files. `git diff --cached --numstat` prints "-" for the
	# added/removed line counts of a binary blob.
	numstat=$(git diff --cached --numstat -- "$file")
	case "$numstat" in
	"-"*) continue ;;
	esac

	# Scan the exact staged blob (":$file" is the staged version).
	matches=$(git show ":$file" 2>/dev/null | scan)
	if [ -n "$matches" ]; then
		if [ "$found" -eq 0 ]; then
			echo "Commit blocked: staged files contain text in an unsupported language." >&2
			echo "Only English and Ukrainian are allowed." >&2
			echo >&2
		fi
		found=1
		echo "  $file" >&2
		echo "$matches" >&2
	fi
done <<EOF
$(git diff --cached --name-only --diff-filter=ACM)
EOF

if [ "$found" -ne 0 ]; then
	echo >&2
	echo "Remove that text and commit again." >&2
	exit 1
fi

exit 0
